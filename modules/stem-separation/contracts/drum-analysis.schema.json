{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "harbeat://modules/stem-separation/drum-analysis/v2",
  "title": "HarBeat drum analysis",
  "type": "object",
  "required": [
    "version", "source", "status", "needs_review", "events", "counts",
    "density_curve", "pattern", "fills", "confidence", "quality_flags", "engine_routes"
  ],
  "properties": {
    "version": {"const": "drum_transcription_consensus_v2"},
    "source": {"const": "demucs_drums_stem"},
    "selected_engine": {"type": "string"},
    "detector_mode": {"enum": ["dedicated_model", "fallback"]},
    "status": {"enum": ["ready", "degraded", "unavailable"]},
    "needs_review": {"type": "boolean"},
    "reason": {"type": ["string", "null"]},
    "events": {
      "type": "object",
      "required": ["kick", "snare", "hihat", "tom", "cymbal"],
      "additionalProperties": false,
      "properties": {
        "kick": {"$ref": "#/$defs/events"},
        "snare": {"$ref": "#/$defs/events"},
        "hihat": {"$ref": "#/$defs/events"},
        "tom": {"$ref": "#/$defs/events"},
        "cymbal": {"$ref": "#/$defs/events"}
      }
    },
    "counts": {
      "type": "object",
      "required": ["kick", "snare", "hihat", "tom", "cymbal"],
      "additionalProperties": false,
      "properties": {
        "kick": {"type": "integer", "minimum": 0},
        "snare": {"type": "integer", "minimum": 0},
        "hihat": {"type": "integer", "minimum": 0},
        "tom": {"type": "integer", "minimum": 0},
        "cymbal": {"type": "integer", "minimum": 0}
      }
    },
    "density_curve": {"type": "array", "items": {"type": "object"}},
    "pattern": {
      "type": "object",
      "required": ["resolution", "bars_analyzed", "dominant", "stability", "syncopation"]
    },
    "fills": {"type": "array", "items": {"type": "object"}},
    "confidence": {"type": "object"},
    "quality_flags": {"type": "array", "items": {"type": "string"}},
    "engine_routes": {"type": "object"}
  },
  "$defs": {
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["time", "confidence", "velocity"],
        "properties": {
          "time": {"type": "number", "minimum": 0},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "velocity": {"type": "integer", "minimum": 0, "maximum": 127}
        }
      }
    }
  }
}
