{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "harbeat://modules/stem-separation/pre-style-features/v2",
  "title": "HarBeat pre-style feature evidence",
  "type": "object",
  "required": [
    "version", "status", "needs_review", "rhythm_grammar",
    "low_frequency", "percussion_timbre", "sonic_profile",
    "confidence", "quality_flags", "selected_models", "model_evidence"
  ],
  "properties": {
    "version": {"const": "pre_style_evidence_v2"},
    "status": {"enum": ["ready", "degraded", "unavailable"]},
    "needs_review": {"type": "boolean"},
    "reason": {"type": ["string", "null"]},
    "rhythm_grammar": {"$ref": "#/$defs/featureGroup"},
    "low_frequency": {"$ref": "#/$defs/featureGroup"},
    "percussion_timbre": {"$ref": "#/$defs/featureGroup"},
    "sonic_profile": {"$ref": "#/$defs/featureGroup"},
    "confidence": {"type": "object"},
    "quality_flags": {"type": "array", "items": {"type": "string"}},
    "selected_models": {"type": "array", "items": {"type": "string"}},
    "model_evidence": {"type": "object"}
  },
  "$defs": {
    "featureGroup": {
      "type": "object",
      "additionalProperties": {"$ref": "#/$defs/feature"}
    },
    "feature": {
      "type": "object",
      "required": ["detected", "score", "confidence", "time_ranges", "evidence"],
      "properties": {
        "detected": {"type": "boolean"},
        "score": {"type": "number", "minimum": 0, "maximum": 1},
        "decision_threshold": {"type": "number", "minimum": 0, "maximum": 1},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "time_ranges": {"type": "array", "items": {"type": "object"}},
        "evidence": {"type": "object"}
      }
    }
  }
}
