APP_NAME=Street Dance MVP API
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
DATABASE_URL=postgresql+psycopg2://harbeat:<password>@<host>:5432/rhythm_prism
REDIS_URL=redis://localhost:6379/0
JWT_SECRET=change-me
JWT_ALGORITHM=HS256
UPLOAD_DIR=./data/music-files

# Public URL RK3588 can use to download /api/assets/* from the Jetson/backend.
# Leave empty in local development; set to e.g. http://100.x.y.z:8000 in Tailscale deployment.
PUBLIC_ASSET_BASE_URL=

# Optional metadata enrichment for library genre classification.
# Spotify provides artist/album microgenres; Discogs provides release genre/style tags.
SPOTIPY_CLIENT_ID=
SPOTIPY_CLIENT_SECRET=
DISCOGS_USER_TOKEN=
DISCOGS_USER_AGENT=HarBeat/1.0 +https://github.com/jihaobi123/harbeat-client
LASTFM_API_KEY=
MUSICBRAINZ_APP_NAME=HarBeat
MUSICBRAINZ_APP_VERSION=1.0.0
MUSICBRAINZ_CONTACT_EMAIL=
CYANITE_API_KEY=
BRIDGE_API_KEY=
AIMS_API_KEY=
ENABLE_EXTERNAL_MUSIC_TAGS=0

# Three-engine BPM consensus. Values within +/- tolerance form one vote group.
# Beat This defaults to CPU so it can run alongside GPU/MPS All-In-One.
BPM_ENABLE_BEAT_THIS=true
BPM_ENABLE_ALL_IN_ONE=true
BPM_ENABLE_ESSENTIA=true
BPM_CONSENSUS_TOLERANCE=2.0
BPM_BEAT_THIS_MODEL=final0
BPM_BEAT_THIS_DEVICE=cpu
BPM_ALL_IN_ONE_MODEL=harmonix-all
# Leave empty for auto detection: CUDA -> MPS -> CPU.
BPM_ALL_IN_ONE_DEVICE=
# macOS only: optional FFmpeg 7 shared-library directory for TorchCodec.
# Empty uses .runtime/ffmpeg-shared/lib when present.
ALL_IN_ONE_FFMPEG_SHARED_LIB_DIR=

# Native downbeat/bar consensus. All engines receive the same decoded waveform.
DOWNBEAT_ENABLE_MADMOM=true
DOWNBEAT_MATCH_TOLERANCE_MS=70
DOWNBEAT_AGREEMENT_F1=0.70
# KPOP/dance default. Use "3,4" for a mixed 3/4 + 4/4 catalog.
DOWNBEAT_MADMOM_BEATS_PER_BAR=4

# External style enrichment for DJ Control style picking.
ENABLE_EXTERNAL_STYLE_ENRICHMENT=true
EXTERNAL_STYLE_CACHE_TTL_DAYS=30
EXTERNAL_STYLE_TIMEOUT_SEC=8
EXTERNAL_STYLE_MAX_CONCURRENCY=3
STYLE_SCORE_WEIGHT_EXTERNAL=0.50
STYLE_SCORE_WEIGHT_LOCAL=0.35
STYLE_SCORE_WEIGHT_MANUAL=0.10
STYLE_SCORE_WEIGHT_TUNABLE=0.05
STYLE_EXTERNAL_WEIGHT_DISCOGS=0.45
STYLE_EXTERNAL_WEIGHT_LASTFM=0.35
STYLE_EXTERNAL_WEIGHT_MUSICBRAINZ=0.20

# Optional dedicated drum transcriber. The worker must print one JSON object
# to stdout and include the literal {audio} placeholder. No shell is used.
# Example: python /opt/harbeat-models/drum_worker.py --audio {audio}
FEATURE_DRUM_TRANSCRIBER_COMMAND=
# Optional note transcription for the isolated Bass stem.
FEATURE_BASS_TRANSCRIBER_COMMAND=
# Optional style-label worker, or local Essentia Discogs model + metadata.
# Both routes are auxiliary evidence and are disabled when left empty.
FEATURE_STYLE_TAGGER_COMMAND=
# Optional broad instrument tags; narrow instrument identities remain candidates.
FEATURE_INSTRUMENT_TAGGER_COMMAND=
ESSENTIA_DISCOGS_MODEL_PATH=
ESSENTIA_DISCOGS_METADATA_PATH=
FEATURE_MODEL_TIMEOUT_SECONDS=300
# Optional residual classifier for SongFormer section names.  With no validated
# model present the analysis safely keeps SongFormer's candidate labels.
SECTION_RELABELER_ENABLED=true
SECTION_RELABELER_SHADOW_MODE=true
# SECTION_RELABELER_MODEL=/absolute/path/to/songformer_section_relabeler_v2.json
