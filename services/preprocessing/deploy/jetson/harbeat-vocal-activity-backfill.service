[Unit]
Description=HarBeat Silero vocal markers (all published songs, resumable)
After=network-online.target remote-fs.target
Wants=network-online.target
RequiresMountsFor=/mnt/nas/harbeat

[Service]
Type=oneshot
ExecStart=/usr/local/bin/harbeat-vocal-activity-backfill
TimeoutStartSec=infinity
Nice=10
Environment=OMP_NUM_THREADS=1
# Failure is visible. Restart manually after diagnosis; completed songs are cached.

[Install]
WantedBy=multi-user.target
