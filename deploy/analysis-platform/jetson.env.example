# Bind only to Jetson's private Tailscale address. Do not use 0.0.0.0.
ANALYSIS_LAB_BIND=100.87.142.21
ANALYSIS_LAB_PORT=8765
ANALYSIS_LAB_DIR=/mnt/nas/harbeat/data/analysis-platform
ANALYSIS_MODELS_DIR=/mnt/nas/harbeat/models/analysis-platform
ANALYSIS_PUBLIC_ORIGIN=https://analysis.YOUR_DOMAIN
# Generate a random token, keep this file mode 0600, and put the same token in
# Aliyun's root-owned /etc/nginx/snippets/harbeat-analysis-token.conf.
ANALYSIS_RELAY_TOKEN=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
# Enable only after the ARM64 interpreter passes the real model smoke test.
# ANALYSIS_MODEL_PYTHON=/opt/harbeat-analysis-models/bin/python
OMP_NUM_THREADS=1
OPENBLAS_NUM_THREADS=1
