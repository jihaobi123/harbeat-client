#!/usr/bin/env bash
set -euo pipefail

RELEASE_ROOT="${HARBEAT_PREPROCESS_RELEASE:-/opt/harbeat/same-style-preprocess-current}"
CORE_PYTHON="${HARBEAT_CORE_PYTHON:-/opt/harbeat/current/venv/bin/python}"
RUNTIME_ROOT="${HARBEAT_RUNTIME_ROOT:-/opt/harbeat/runtime}"
MODEL_ROOT="${HARBEAT_MODEL_ROOT:-/opt/harbeat/models}"

export HARBEAT_PREPROCESS_ROOT="${HARBEAT_PREPROCESS_ROOT:-/mnt/nas/harbeat/preprocess}"
export HARBEAT_MDX23C_CACHE_DIR="${HARBEAT_MDX23C_CACHE_DIR:-/mnt/nas/harbeat/models/mdx23c}"
export SECTION_SONGFORMER_COMMAND="${SECTION_SONGFORMER_COMMAND:-$RUNTIME_ROOT/songformer-python $RELEASE_ROOT/experiments/run_songformer_isolated.py {audio} --out-dir {output_dir} --source-root $MODEL_ROOT/SongFormer --muq-model $MODEL_ROOT/MuQ-large-msd-iter --device cuda --precision float16}"
export SECTION_SONGFORMER_WORK_DIR="${SECTION_SONGFORMER_WORK_DIR:-/mnt/nas/harbeat/cache/songformer-analysis}"
export FEATURE_DRUM_TRANSCRIBER_COMMAND="${FEATURE_DRUM_TRANSCRIBER_COMMAND:-$RUNTIME_ROOT/instrument-analysis-python $RELEASE_ROOT/scripts/adtof_drum_worker.py --audio {audio} --device cuda}"
export FEATURE_MODEL_TIMEOUT_SECONDS="${FEATURE_MODEL_TIMEOUT_SECONDS:-1800}"
export BPM_ENABLE_BEAT_THIS="${BPM_ENABLE_BEAT_THIS:-true}"
export BPM_ENABLE_ALL_IN_ONE="${BPM_ENABLE_ALL_IN_ONE:-true}"
export BPM_ENABLE_ESSENTIA="${BPM_ENABLE_ESSENTIA:-true}"
export DOWNBEAT_ENABLE_MADMOM="${DOWNBEAT_ENABLE_MADMOM:-true}"
export BPM_BEAT_THIS_DEVICE="${BPM_BEAT_THIS_DEVICE:-cpu}"
export BPM_ALL_IN_ONE_DEVICE="${BPM_ALL_IN_ONE_DEVICE:-cuda}"

export PYTHONPATH="$RELEASE_ROOT/vendor:$RUNTIME_ROOT/preprocess-packages:$RELEASE_ROOT${PYTHONPATH:+:$PYTHONPATH}"
exec "$CORE_PYTHON" "$RELEASE_ROOT/scripts/run_same_style_preprocess.py" "$@"
