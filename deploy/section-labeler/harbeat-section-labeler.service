[Unit]
Description=HarBeat Section Labeler
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/harbeat-section-labeler
ExecStart=/opt/harbeat-section-labeler/.venv/bin/python scripts/section_label_workbench.py /srv/harbeat-section-labeler/data/annotations.json --host 127.0.0.1 --port 8765 --partition-count 2 --no-open
Restart=always
RestartSec=3
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/srv/harbeat-section-labeler/data

[Install]
WantedBy=multi-user.target
