{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "model_manifest_v1.schema.json",
  "title": "HarBeat Model Manifest 1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_name",
    "schema_version",
    "model_id",
    "model_version",
    "task_ids",
    "status",
    "artifact_uri",
    "artifact_sha256",
    "framework",
    "input_schema",
    "output_schema",
    "backbone_id",
    "backbone_sha256",
    "dataset_version",
    "split_version",
    "feature_definition_version",
    "preprocessing_version",
    "training_config_sha256",
    "code_commit",
    "metrics",
    "thresholds",
    "calibration_version",
    "license_id",
    "limitations",
    "fallback_model_id",
    "approved_by",
    "approved_at"
  ],
  "properties": {
    "schema_name": {
      "const": "harbeat.model_manifest"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "model_id": {
      "$ref": "bar_feature_v1.schema.json#/$defs/id"
    },
    "model_version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "task_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "bar_feature_v1.schema.json#/$defs/id"
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "candidate",
        "staging",
        "production",
        "retired",
        "rejected"
      ]
    },
    "artifact_uri": {
      "type": "string",
      "pattern": "^(model|s3|gs|https)://.+$"
    },
    "artifact_sha256": {
      "$ref": "track_analysis_v1.schema.json#/$defs/sha256"
    },
    "framework": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "export_format"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "export_format": {
          "type": "string",
          "enum": [
            "onnx",
            "torchscript",
            "safetensors",
            "skops",
            "other"
          ]
        }
      }
    },
    "input_schema": {
      "type": "string",
      "minLength": 1
    },
    "output_schema": {
      "type": "string",
      "minLength": 1
    },
    "backbone_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "backbone_sha256": {
      "$ref": "track_analysis_v1.schema.json#/$defs/nullable_sha256"
    },
    "dataset_version": {
      "type": "string",
      "minLength": 1
    },
    "split_version": {
      "type": "string",
      "minLength": 1
    },
    "feature_definition_version": {
      "type": "string",
      "minLength": 1
    },
    "preprocessing_version": {
      "type": "string",
      "minLength": 1
    },
    "training_config_sha256": {
      "$ref": "track_analysis_v1.schema.json#/$defs/sha256"
    },
    "code_commit": {
      "type": "string",
      "minLength": 7,
      "maxLength": 64,
      "pattern": "^[a-fA-F0-9]+$"
    },
    "metrics": {
      "type": "object",
      "additionalProperties": {
        "type": "number"
      }
    },
    "thresholds": {
      "type": "object",
      "additionalProperties": {
        "type": "number"
      }
    },
    "calibration_version": {
      "type": [
        "string",
        "null"
      ]
    },
    "license_id": {
      "type": "string",
      "minLength": 1
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "fallback_model_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "approved_by": {
      "type": [
        "string",
        "null"
      ]
    },
    "approved_at": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
