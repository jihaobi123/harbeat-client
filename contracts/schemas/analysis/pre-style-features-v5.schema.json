{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "harbeat://modules/stem-separation/pre-style-features/v5",
  "title": "HarBeat pre-style feature evidence v5",
  "type": "object",
  "required": ["version", "status", "feature_groups", "confidence", "quality_flags"],
  "properties": {
    "version": {"const": "pre_style_evidence_v5"},
    "status": {"enum": ["ready", "degraded", "unavailable"]},
    "feature_groups": {
      "type": "object",
      "additionalProperties": {"$ref": "#/$defs/featureGroup"}
    },
    "validation_summary": {"type": "object"},
    "confidence": {"type": "object"},
    "quality_flags": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "featureGroup": {
      "type": "object",
      "additionalProperties": {"$ref": "#/$defs/feature"}
    },
    "quality": {
      "type": "object",
      "required": ["measurement_confidence", "source_quality", "estimator_quality", "calibration_status"],
      "properties": {
        "measurement_confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "source_quality": {"type": "number", "minimum": 0, "maximum": 1},
        "estimator_quality": {"type": "number", "minimum": 0, "maximum": 1},
        "coverage": {"type": "number", "minimum": 0, "maximum": 1},
        "stability": {"type": "number", "minimum": 0, "maximum": 1},
        "reliability_cap": {"type": "number", "minimum": 0, "maximum": 1},
        "calibration_status": {"type": "string"}
      }
    },
    "feature": {
      "type": "object",
      "required": [
        "availability", "detected", "score", "decision_threshold", "confidence",
        "reliability", "quality", "quality_flags", "evidence_level",
        "analysis_method", "sources", "time_ranges", "evidence",
        "semantic_level", "canonical_name", "measurement_score",
        "technical_reliability", "probability", "decision", "validation_status", "validation_scope",
        "calibration_version", "style_required_allowed"
      ],
      "properties": {
        "availability": {"enum": ["available", "unavailable"]},
        "detected": {"type": ["boolean", "null"]},
        "score": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "decision_threshold": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "reliability": {"type": "number", "minimum": 0, "maximum": 1},
        "quality": {"$ref": "#/$defs/quality"},
        "quality_flags": {"type": "array", "items": {"type": "string"}},
        "evidence_level": {"enum": ["confirmed", "probable", "candidate", "unavailable"]},
        "analysis_method": {"type": "string", "minLength": 1},
        "sources": {"type": "array", "items": {"type": "string"}},
        "time_ranges": {"type": "array", "items": {"type": "object"}},
        "evidence": {"type": "object"},
        "semantic_level": {"enum": ["measurement", "derived", "semantic"]},
        "canonical_name": {"type": "string", "minLength": 1},
        "measurement_score": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "technical_reliability": {"type": "number", "minimum": 0, "maximum": 1},
        "probability": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "decision": {"enum": ["present", "candidate", "absent", "not_detected", "unknown", "rejected"]},
        "validation_status": {"enum": ["validated", "failed_validation", "provisional", "candidate_only", "unavailable", "deprecated"]},
        "validation_scope": {"type": "string"},
        "calibration_version": {"type": "string", "minLength": 1},
        "style_required_allowed": {"type": "boolean"}
      }
    }
  }
}
