{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "analysis_job_v1.schema.json",
  "title": "HarBeat Analysis Job 1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_name",
    "schema_version",
    "job_id",
    "track_id",
    "status",
    "requested_feature_sets",
    "attempt",
    "max_attempts",
    "progress",
    "stages",
    "analysis_id",
    "error",
    "created_at",
    "started_at",
    "heartbeat_at",
    "ended_at"
  ],
  "properties": {
    "schema_name": {
      "const": "harbeat.analysis_job"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "job_id": {
      "$ref": "bar_feature_v1.schema.json#/$defs/id"
    },
    "track_id": {
      "$ref": "bar_feature_v1.schema.json#/$defs/id"
    },
    "status": {
      "type": "string",
      "enum": [
        "queued",
        "running",
        "succeeded",
        "partial",
        "failed",
        "cancelled"
      ]
    },
    "requested_feature_sets": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "timeline",
          "stems",
          "explicit",
          "mert",
          "bar_content",
          "structure"
        ]
      }
    },
    "attempt": {
      "type": "integer",
      "minimum": 1
    },
    "max_attempts": {
      "type": "integer",
      "minimum": 1
    },
    "progress": {
      "$ref": "bar_feature_v1.schema.json#/$defs/probability"
    },
    "stages": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decode",
        "timeline",
        "stems",
        "explicit",
        "mert",
        "bar_content",
        "structure",
        "persist"
      ],
      "properties": {
        "decode": {
          "$ref": "#/$defs/stage"
        },
        "timeline": {
          "$ref": "#/$defs/stage"
        },
        "stems": {
          "$ref": "#/$defs/stage"
        },
        "explicit": {
          "$ref": "#/$defs/stage"
        },
        "mert": {
          "$ref": "#/$defs/stage"
        },
        "bar_content": {
          "$ref": "#/$defs/stage"
        },
        "structure": {
          "$ref": "#/$defs/stage"
        },
        "persist": {
          "$ref": "#/$defs/stage"
        }
      }
    },
    "analysis_id": {
      "anyOf": [
        {
          "$ref": "bar_feature_v1.schema.json#/$defs/id"
        },
        {
          "type": "null"
        }
      ]
    },
    "error": {
      "anyOf": [
        {
          "$ref": "#/$defs/error"
        },
        {
          "type": "null"
        }
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "started_at": {
      "$ref": "#/$defs/nullable_timestamp"
    },
    "heartbeat_at": {
      "$ref": "#/$defs/nullable_timestamp"
    },
    "ended_at": {
      "$ref": "#/$defs/nullable_timestamp"
    }
  },
  "$defs": {
    "nullable_timestamp": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        {
          "type": "null"
        }
      ]
    },
    "stage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "started_at",
        "ended_at",
        "error_code"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "pending",
            "running",
            "succeeded",
            "skipped",
            "failed"
          ]
        },
        "started_at": {
          "$ref": "#/$defs/nullable_timestamp"
        },
        "ended_at": {
          "$ref": "#/$defs/nullable_timestamp"
        },
        "error_code": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message",
        "stage",
        "retryable",
        "details"
      ],
      "properties": {
        "code": {
          "type": "string",
          "enum": [
            "INPUT_NOT_FOUND",
            "AUDIO_DECODE_FAILED",
            "TIMELINE_FAILED",
            "TIMELINE_SUSPECT",
            "STEM_FAILED",
            "EXPLICIT_FEATURE_FAILED",
            "MERT_FAILED",
            "MODEL_INFERENCE_FAILED",
            "SCHEMA_VALIDATION_FAILED",
            "PERSIST_FAILED",
            "WORKER_LOST",
            "CANCELLED_BY_USER"
          ]
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "stage": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "decode",
            "timeline",
            "stems",
            "explicit",
            "mert",
            "bar_content",
            "structure",
            "persist",
            null
          ]
        },
        "retryable": {
          "type": "boolean"
        },
        "details": {
          "type": "object"
        }
      }
    }
  }
}
