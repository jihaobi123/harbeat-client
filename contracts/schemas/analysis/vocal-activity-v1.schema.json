{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HarBeat vocal activity v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_name",
    "schema_version",
    "status",
    "generated_at",
    "source",
    "producer",
    "unit",
    "time_origin",
    "interval_convention",
    "duration_ms",
    "intervals",
    "has_vocals",
    "active_duration_ms",
    "coverage_ratio",
    "needs_review",
    "quality_flags"
  ],
  "properties": {
    "schema_name": {
      "const": "harbeat_vocal_activity"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "status": {
      "const": "ready"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "track_id",
        "analysis_run_id",
        "manifest_storage_key",
        "manifest_sha256",
        "vocal_storage_key",
        "vocal_sha256"
      ],
      "properties": {
        "track_id": {
          "type": "string"
        },
        "analysis_run_id": {
          "type": "string"
        },
        "manifest_storage_key": {
          "type": "string"
        },
        "manifest_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "vocal_storage_key": {
          "type": "string"
        },
        "vocal_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "implementation",
        "model",
        "package_version",
        "model_sha256",
        "backend",
        "torch_version",
        "parameters",
        "resampling",
        "channel_reduction"
      ],
      "properties": {
        "implementation": {
          "const": "silero_vocal_activity_v1"
        },
        "model": {
          "const": "silero_vad"
        },
        "package_version": {
          "type": "string"
        },
        "model_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "backend": {
          "const": "torchscript_cpu"
        },
        "torch_version": {
          "type": "string"
        },
        "parameters": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "threshold",
            "neg_threshold",
            "min_speech_duration_ms",
            "min_silence_duration_ms",
            "speech_pad_ms",
            "sampling_rate"
          ],
          "properties": {
            "threshold": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "neg_threshold": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "min_speech_duration_ms": {
              "type": "integer",
              "minimum": 0
            },
            "min_silence_duration_ms": {
              "type": "integer",
              "minimum": 0
            },
            "speech_pad_ms": {
              "type": "integer",
              "minimum": 0
            },
            "sampling_rate": {
              "const": 16000
            }
          }
        },
        "resampling": {
          "const": "scipy.signal.resample_poly"
        },
        "channel_reduction": {
          "const": "arithmetic_mean"
        }
      }
    },
    "unit": {
      "const": "ms"
    },
    "time_origin": {
      "const": "master_audio_start"
    },
    "interval_convention": {
      "const": "[start_ms,end_ms)"
    },
    "duration_ms": {
      "type": "integer",
      "minimum": 1
    },
    "intervals": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "start_ms",
          "end_ms"
        ],
        "properties": {
          "start_ms": {
            "type": "integer",
            "minimum": 0
          },
          "end_ms": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "has_vocals": {
      "type": "boolean"
    },
    "active_duration_ms": {
      "type": "integer",
      "minimum": 0
    },
    "coverage_ratio": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "needs_review": {
      "const": true
    },
    "quality_flags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
