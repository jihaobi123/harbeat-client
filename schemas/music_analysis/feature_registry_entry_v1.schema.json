{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "feature_registry_entry_v1.schema.json",
  "title": "HarBeat Feature Registry Entry 1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_name",
    "schema_version",
    "feature_id",
    "definition_version",
    "display_name_zh",
    "json_path",
    "granularity",
    "dtype",
    "unit",
    "allowed_values_or_range",
    "semantic_definition",
    "source_policy",
    "dependencies",
    "missing_policy",
    "consumers",
    "validation_metric",
    "production_threshold",
    "status",
    "owner",
    "license_id"
  ],
  "properties": {
    "schema_name": {
      "const": "harbeat.feature_registry_entry"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "feature_id": {
      "$ref": "bar_feature_v1.schema.json#/$defs/id"
    },
    "definition_version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "display_name_zh": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "json_path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*$"
    },
    "granularity": {
      "type": "string",
      "enum": [
        "track",
        "section",
        "bar",
        "beat",
        "event"
      ]
    },
    "dtype": {
      "type": "string",
      "enum": [
        "boolean",
        "integer",
        "number",
        "enum",
        "vector",
        "segment_list"
      ]
    },
    "unit": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "second",
        "bpm",
        "lufs",
        "dbfs",
        "ratio",
        "probability",
        "normalized_score",
        null
      ]
    },
    "allowed_values_or_range": {
      "type": [
        "object",
        "array",
        "null"
      ]
    },
    "semantic_definition": {
      "type": "string",
      "minLength": 1
    },
    "source_policy": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "explicit",
          "rule",
          "pretrained_model",
          "trained_head",
          "manual",
          "derived"
        ]
      }
    },
    "dependencies": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "bar_feature_v1.schema.json#/$defs/id"
      }
    },
    "missing_policy": {
      "type": "string",
      "enum": [
        "null",
        "unknown",
        "block"
      ]
    },
    "consumers": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "planner",
          "ui",
          "training",
          "evaluation",
          "rk",
          "api"
        ]
      }
    },
    "validation_metric": {
      "type": "string",
      "minLength": 1
    },
    "production_threshold": {
      "type": [
        "number",
        "string",
        "null"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "planned",
        "implemented",
        "provisional",
        "validated",
        "retired"
      ]
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "license_id": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
